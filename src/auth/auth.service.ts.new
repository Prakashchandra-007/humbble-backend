// src/auth/auth.service.ts

import { Injectable, UnauthorizedException } from '@nestjs/common';
import { JwtService } from '@nestjs/jwt';
import { ConfigService } from '@nestjs/config';
import { DatabaseService } from '../database/database.service';
import * as bcrypt from 'bcrypt';
import { LoginDto } from './dto/login.dto';
import { RegisterDto } from './dto/register.dto';
import { JwtPayload, User, UserWithoutPassword } from '../types/user.types';
import { LoggerService } from '../common/logger/logger.service';

// Google OAuth API response types for type safety
interface GoogleTokenInfo {
  access_token: string;
  expires_in: number;
  scope: string;
  token_type: string;
  issued_to?: string;
}

interface GoogleUserProfile {
  id: string;
  email: string;
  verified_email: boolean;
  name?: string;
  given_name?: string;
  family_name?: string;
  picture?: string;
  locale?: string;
}

@Injectable()
export class AuthService {
  private readonly SALT_ROUNDS = 12; // Increased for better security

  constructor(
    private jwtService: JwtService,
    private configService: ConfigService,
    private databaseService: DatabaseService,
    private loggerService: LoggerService,
  ) {}

  // Helper method to hash passwords with consistent salt rounds
  private async hashPassword(password: string): Promise<string> {
    return bcrypt.hash(password, this.SALT_ROUNDS);
  }

  // Helper to safely exclude password from user objects
  private excludePassword(user: any): UserWithoutPassword {
    const { password, ...userWithoutPassword } = user;
    return userWithoutPassword as UserWithoutPassword;
  }

  async register(dto: RegisterDto) {
    const { email, password, name, phone, role } = dto;

    if (!email || !password) {
      throw new UnauthorizedException('Email and password are required');
    }

    // Check if user already exists
    const existingUser = await this.databaseService.findOne('users', {
      email: email.toLowerCase(),
    });

    if (existingUser) {
      throw new UnauthorizedException('User already exists with this email');
    }

    // Hash password
    const hashedPassword = await this.hashPassword(password);

    try {
      // Create new user with role (defaults to 'user' if not specified)
      const newUser = await this.databaseService.createUser({
        email: email.toLowerCase(),
        password: hashedPassword,
        name: name || null,
        phone: phone || null,
        role: role || 'user',
        // Note: created_at and updated_at are set by database defaults/triggers
      });

      // Generate JWT token with role
      const payload = {
        sub: newUser.id,
        email: newUser.email,
        user_metadata: { role: newUser.role },
      };
      const accessToken = this.jwtService.sign(payload);

      return {
        message: 'User registered successfully',
        user: {
          id: newUser.id,
          email: newUser.email,
          name: newUser.name,
          role: newUser.role,
          created_at: newUser.created_at,
        },
        accessToken,
      };
    } catch (error) {
      this.loggerService.error(
        'User registration failed',
        error,
        'AuthService.register',
      );
      throw new UnauthorizedException('Registration failed');
    }
  }

  async signIn(loginDto: LoginDto) {
    const { email, password } = loginDto;

    try {
      // Use findUserByEmail which returns the complete UserRow including password for validation
      const user = await this.databaseService.findUserByEmail(
        email.toLowerCase(),
      );

      if (!user) {
        throw new UnauthorizedException('Invalid credentials');
      }

      // Compare passwords
      const isPasswordValid = await bcrypt.compare(password, user.password);

      if (!isPasswordValid) {
        throw new UnauthorizedException('Invalid credentials');
      }

      // Create JWT payload
      const payload = {
        sub: user.id,
        email: user.email,
        user_metadata: { role: user.role },
      };

      const accessToken = this.jwtService.sign(payload);

      this.loggerService.logAuthEvent('User signed in', user.id.toString(), {
        email: user.email,
      });

      return {
        message: 'Sign in successful',
        user: this.excludePassword(user),
        accessToken,
      };
    } catch (error) {
      this.loggerService.error('Sign in failed', error, 'AuthService.signIn');
      throw error;
    }
  }

  async signInWithGoogle(token: string) {
    try {
      // Check if Google OAuth is enabled
      const isGoogleOAuthEnabled = this.configService.get<boolean>(
        'ENABLE_GOOGLE_OAUTH',
        false,
      );

      if (!isGoogleOAuthEnabled) {
        throw new UnauthorizedException('Google OAuth is disabled');
      }

      // Verify Google token and get user info
      const googleUser = await this.verifyGoogleToken(token);

      if (!googleUser) {
        throw new UnauthorizedException('Invalid Google token');
      }

      // Check if user exists in our database
      let user = await this.databaseService.findUserByEmail(googleUser.email);

      if (!user) {
        // Create new user from Google profile
        const newUserData = {
          email: googleUser.email.toLowerCase(),
          name: googleUser.name || null,
          // No password needed for OAuth users
          role: 'user' as const,
          // Note: created_at and updated_at are set by database defaults/triggers
        };

        await this.databaseService.createUser(newUserData);

        // Fetch the complete user record
        user = await this.databaseService.findUserByEmail(googleUser.email);

        if (!user) {
          throw new Error('Failed to create user');
        }

        this.loggerService.logAuthEvent(
          'Google OAuth user created',
          user.id.toString(),
          { email: googleUser.email },
        );
      } else {
        this.loggerService.logAuthEvent(
          'Google OAuth sign in',
          user.id.toString(),
          { email: googleUser.email },
        );
      }

      // Generate JWT token
      const payload = {
        sub: user.id,
        email: user.email,
        user_metadata: { role: user.role },
      };
      const accessToken = this.jwtService.sign(payload);

      return {
        message: 'Google OAuth successful',
        user: this.excludePassword(user),
        accessToken,
      };
    } catch (error) {
      this.loggerService.error(
        'Google OAuth sign in failed',
        error,
        'AuthService.signInWithGoogle',
      );
      throw error;
    }
  }

  private async verifyGoogleToken(token: string): Promise<{
    email: string;
    name?: string;
    picture?: string;
    sub: string;
  } | null> {
    try {
      // Verify token with Google
      const response = await fetch(
        `https://www.googleapis.com/oauth2/v1/tokeninfo?access_token=${token}`,
      );

      if (!response.ok) {
        throw new Error('Failed to verify token with Google');
      }

      const tokenInfo = (await response.json()) as GoogleTokenInfo;

      // Get user profile from Google
      const profileResponse = await fetch(
        `https://www.googleapis.com/oauth2/v2/userinfo?access_token=${token}`,
      );

      if (!profileResponse.ok) {
        throw new Error('Failed to get user profile from Google');
      }

      const profile = (await profileResponse.json()) as GoogleUserProfile;

      return {
        email: profile.email,
        name: profile.name,
        picture: profile.picture,
        sub: profile.id,
      };
    } catch (error) {
      this.loggerService.error(
        'Google token verification failed',
        error,
        'AuthService.verifyGoogleToken',
      );
      return null;
    }
  }

  async validateUser(userId: number): Promise<UserWithoutPassword> {
    // Use findUserByIdWithoutPassword for proper typing
    const user = await this.databaseService.findUserByIdWithoutPassword(userId);

    if (!user) {
      throw new UnauthorizedException('User not found');
    }

    return user;
  }
}
